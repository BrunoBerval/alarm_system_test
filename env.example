# =========================================================
# Portas publicadas no host
# =========================================================
# Se alguma dessas portas já estiver em uso na sua máquina,
# copie este arquivo para .env e ajuste o valor.

EVENT_SERVICE_PORT=8080
ALARM_SERVICE_PORT=8081
MQTT_PORT=1883
POSTGRES_PORT=5432

# =========================================================
# Credenciais do banco
# =========================================================
# O compose repassa esses valores tanto para o container do Postgres
# quanto para o alarm-service (como DB_USER/DB_PASSWORD/DB_NAME).
# Alterar aqui basta: não há mais credencial hardcoded no código.

POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=alarm_db

# =========================================================
# Concorrência do Event Service
# =========================================================
# EVENT_WORKERS: goroutines publicando no broker em paralelo.
# EVENT_BUFFER_SIZE: eventos que cabem na fila interna antes de
# a API começar a responder 503 por sobrecarga.

EVENT_WORKERS=5
EVENT_BUFFER_SIZE=100
