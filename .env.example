# Porta publicada no host para o Postgres.
# O padrão é 5432. Se você já tiver um Postgres rodando na máquina,
# copie este arquivo para .env e troque para 5433 (ou outra livre).
POSTGRES_PORT=5432

# Porta publicada no host para o broker MQTT.
MQTT_PORT=1883

# Portas publicadas no host para os Microsserviços.
# Caso a porta 8080 ou 8081 já esteja em uso, altere aqui.
EVENT_SERVICE_PORT=8080
ALARM_SERVICE_PORT=8081

# Credenciais do banco
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=alarm_db